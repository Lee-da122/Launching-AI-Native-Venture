# Local development defaults to SQLite when DATABASE_URL is blank.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=
ADMIN_EMAIL=
ENABLE_DEMO_FEEDBACK=false

# Optional Phase 3 official source. If absent, K-Startup fails safely and WEVITY can still sync.
# Issued by data.go.kr after applying for the K-Startup Open API.
K_STARTUP_SERVICE_KEY=

# Optional AI Weight Judge. Normal matching and feedback still work when unset.
OPENAI_API_KEY=
AI_WEIGHT_JUDGE_MODEL=
